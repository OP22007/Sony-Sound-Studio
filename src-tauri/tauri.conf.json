{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sound Connect Desktop",
  "version": "0.1.7",
  "identifier": "dev.soundconnect.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "Sound Connect Desktop",
      "visible": false,
      "width": 1440,
      "height": 960,
      "minWidth": 960,
      "minHeight": 680,
      "center": true,
      "backgroundColor": "#171817"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Independent local desktop headphone companion",
    "category": "Music",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzODIzODI3RjA2NTE0NzgKUldSNEZHWHdKemlDNHdDbUNUTU9ZcnV0ZU9Vclh1bnJaTnBvbld0YzFQZkcySlViTXVMa2pwMmcK",
      "endpoints": ["https://github.com/OP22007/Sony-Sound-Studio/releases/download/updater-preview/latest.json"]
    }
  }
}
