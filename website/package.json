{
  "name": "sony-sound-studio-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "devices": "node scripts/generate-devices.mjs",
    "devices:check": "node scripts/generate-devices.mjs --check",
    "prebuild": "npm run devices:check",
    "predev": "npm run devices:check"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.2.8",
    "animejs": "4.3.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
